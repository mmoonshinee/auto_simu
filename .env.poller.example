# FEA Poller Configuration
# Copy this to .env.poller and fill in the values

# URL of the Vercel website
VERCEL_URL=https://auto-simu.vercel.app

# Shared API key for authenticating with the Vercel API
# Must match FEA_API_KEY in Vercel environment variables
FEA_API_KEY=fea-local-api-key-change-me

# Poll interval in seconds (how often to check for new jobs)
POLL_INTERVAL=5
