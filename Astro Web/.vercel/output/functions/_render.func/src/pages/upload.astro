---
import config from "@/config";
import Layout from "@/layouts/Layout.astro";

const title = "FEA Analysis | " + config.site.title;
---

<Layout title={title} description="Upload CAD files for real ANSYS FEA analysis">
  <main class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1 class="text-3xl font-bold mb-2">FEA Analysis</h1>
    <p class="text-muted-foreground mb-4">
      Upload a STEP file for automated ANSYS Mechanical FEA. Your file is sent to our analysis server for real structural simulation.
    </p>

    <!-- Configuration Toggle -->
    <div class="mb-4">
      <button id="cfg-toggle" class="text-sm text-muted-foreground hover:text-foreground underline">
        Server Configuration
      </button>
      <div id="cfg-panel" class="hidden mt-2 p-4 border border-border rounded-lg bg-muted/30 space-y-3">
        <div>
          <label class="block text-sm font-medium mb-1">FEA Backend URL</label>
          <input type="text" id="cfg-backend-url"
                 class="w-full bg-background border border-border rounded-md px-3 py-1.5 text-sm
                        focus:outline-none focus:border-accent"
                 placeholder="http://localhost:8000" />
          <p class="text-xs text-muted-foreground mt-0.5">URL of the ANSYS FEA server (local or tunnel)</p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">API Token</label>
          <input type="password" id="cfg-api-token"
                 class="w-full bg-background border border-border rounded-md px-3 py-1.5 text-sm
                        focus:outline-none focus:border-accent"
                 placeholder="Bearer token for FEA server" />
          <p class="text-xs text-muted-foreground mt-0.5">Only needed if your FEA server requires auth</p>
        </div>
        <button id="cfg-save"
                class="bg-accent text-accent-foreground px-4 py-1.5 rounded-md text-sm font-medium
                       hover:opacity-90">
          Save
        </button>
      </div>
    </div>

    <!-- Upload Area -->
    <div id="upload-zone"
         class="border-2 border-dashed border-border rounded-lg p-12 text-center cursor-pointer
                hover:border-accent transition-colors mb-6">
      <input type="file" id="file-input" accept=".step,.stp,.iges,.igs,.x_t,.x_b"
             class="hidden" />
      <div id="upload-prompt">
        <svg class="mx-auto h-12 w-12 text-muted-foreground mb-4" fill="none"
             viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
        </svg>
        <p class="text-lg font-medium">Drop STEP file here or click to browse</p>
        <p class="text-sm text-muted-foreground mt-1">STEP, IGES, or Parasolid — Max 50MB</p>
      </div>
      <div id="upload-status" class="hidden">
        <p id="upload-filename" class="text-lg font-medium"></p>
        <p id="upload-message" class="text-sm text-muted-foreground mt-1"></p>
      </div>
    </div>

    <!-- FEA Settings -->
    <div id="fea-settings" class="hidden mb-6 p-4 border border-border rounded-lg space-y-4">
      <h2 class="text-lg font-semibold">Analysis Settings</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1">Material</label>
          <select id="fea-material"
                  class="w-full bg-background border border-border rounded-md px-3 py-1.5 text-sm
                         focus:outline-none focus:border-accent">
            <option value="Structural Steel">Structural Steel</option>
            <option value="Aluminum Alloy">Aluminum Alloy</option>
            <option value="Stainless Steel">Stainless Steel</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Force Direction</label>
          <select id="fea-force-dir"
                  class="w-full bg-background border border-border rounded-md px-3 py-1.5 text-sm
                         focus:outline-none focus:border-accent">
            <option value="+Z">+Z</option>
            <option value="-Z">-Z</option>
            <option value="+Y">+Y</option>
            <option value="-Y">-Y</option>
            <option value="+X">+X</option>
            <option value="-X">-X</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Force (N)</label>
          <input type="number" id="fea-force-n" value="5000" min="1" max="1000000"
                 class="w-full bg-background border border-border rounded-md px-3 py-1.5 text-sm
                        focus:outline-none focus:border-accent" />
        </div>
      </div>
      <button id="fea-run-btn"
              class="bg-accent text-accent-foreground px-6 py-2 rounded-md text-sm font-medium
                     hover:opacity-90 transition-opacity disabled:opacity-50">
        Run FEA Analysis
      </button>
    </div>

    <!-- Progress -->
    <div id="fea-progress" class="hidden mb-6 p-4 border border-border rounded-lg">
      <p class="text-sm font-medium mb-2" id="fea-progress-text">Starting...</p>
      <div class="w-full bg-muted rounded-full h-3 overflow-hidden">
        <div id="fea-progress-bar" class="bg-accent h-full rounded-full transition-all duration-500"
             style="width: 0%"></div>
      </div>
      <p class="text-xs text-muted-foreground mt-2">
        ANSYS Mechanical cold start takes ~90s. Full analysis: 3-5 minutes.
      </p>
    </div>

    <!-- Results -->
    <div id="fea-results" class="hidden mb-6 p-4 border border-accent/30 rounded-lg bg-muted/20">
      <h2 class="text-lg font-semibold mb-3">FEA Results</h2>
      <div id="fea-result-summary" class="text-sm space-y-1 mb-4"></div>
      <div id="fea-result-images" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
    </div>

    <!-- Chat Area -->
    <div id="chat-container" class="hidden border border-border rounded-lg overflow-hidden">
      <div class="border-b border-border px-4 py-2 bg-muted/30">
        <p class="text-sm font-medium">AI Analysis Chat</p>
        <p class="text-xs text-muted-foreground">Ask about the geometry, results, or design improvements</p>
      </div>
      <div id="chat-messages" class="h-96 overflow-y-auto p-4 space-y-3 bg-background">
        <div class="flex gap-2">
          <span class="text-accent font-bold shrink-0">AI:</span>
          <p class="text-sm">File loaded. Run FEA analysis to get real results, or ask me about the geometry and expected load cases.</p>
        </div>
      </div>
      <div class="border-t border-border p-3 flex gap-2">
        <input type="text" id="chat-input"
               placeholder="Describe what you want to analyze..."
               class="flex-1 bg-transparent px-3 py-2 text-sm border border-border rounded-md
                      focus:outline-none focus:border-accent" />
        <button id="chat-send"
                class="bg-accent text-accent-foreground px-4 py-2 rounded-md text-sm font-medium
                       hover:opacity-90 transition-opacity disabled:opacity-50">
          Send
        </button>
      </div>
    </div>
  </main>
</Layout>

<script src="../scripts/upload.ts"></script>

<style>
  #upload-zone { transition: border-color 0.2s, background 0.2s; }
  #upload-zone.border-accent { background: var(--muted); }
</style>
